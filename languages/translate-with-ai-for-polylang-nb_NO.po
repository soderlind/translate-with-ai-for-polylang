#. Plugin Name of the plugin
#: translate-with-ai-for-polylang.php
msgid "Translate with AI for Polylang"
msgstr "Oversett med KI for Polylang"

#. Description of the plugin
#: translate-with-ai-for-polylang.php
msgid "Makes Polylang's \"Add a translation\" (+) create a linked draft that is translated with the WordPress AI Client in the background."
msgstr "Lar Polylangs «Legg til en oversettelse» (+) opprette et tilknyttet utkast som oversettes med WordPress AI Client i bakgrunnen."

#. Author of the plugin
#: translate-with-ai-for-polylang.php
msgid "Per Soderlind"
msgstr "Per Soderlind"

#. Author URI of the plugin
#: translate-with-ai-for-polylang.php
msgid "https://soderlind.no"
msgstr "https://soderlind.no"

